# ─────────────────────────────────────────────
# 복사해서 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 커밋 금지.
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=papers
POSTGRES_USER=papers
POSTGRES_PASSWORD=change-me-strong-password

# 앱이 접속할 DB 정보
DB_HOST=db
DB_PORT=5432
DB_NAME=papers
DB_USER=papers
DB_PASSWORD=change-me-strong-password

# 최초 관리자 계정 (본인 이메일)
ADMIN_EMAIL=you@univ.ac.kr
ADMIN_PASSWORD=change-me-admin-password

# 논문 저장 루트 (컨테이너 내부 경로 — 수정하지 말 것)
STORAGE_ROOT=/data/papers

# 랩 PC Windows 실제 폴더 (compose 볼륨 매핑용)
HOST_STORAGE_PATH=D:/lab-paper-archive/papers
HOST_DB_PATH=D:/lab-paper-archive/postgres
HOST_LOG_PATH=D:/lab-paper-archive/logs

# 프로파일
SPRING_PROFILES_ACTIVE=prod
